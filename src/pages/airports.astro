---
import BaseLayout from '../layouts/BaseLayout.astro';
import AirportCard from '../components/AirportCard.astro';
import AirportGridCard from '../components/AirportGridCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { AIRPORTS, SITE_CONFIG } from '../data/airports';

const [featuredAirport, ...otherAirports] = AIRPORTS;
---

<BaseLayout
  title={`2026最新高性价比机场排行榜 - ${SITE_CONFIG.title}`}
  description="2026年最新高性价比翻墙机场梯子排行榜，精选优质IEPL专线、便宜平价、按量付费不过期节点，提供晚高峰跑分与优惠券代码。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span>🏆 2026 权威天梯榜</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
        2026 高性价比机场推荐综合排行榜
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        本榜单根据线路类型、晚高峰丢包率与测速、流媒体与 ChatGPT 原生解锁、套餐价格和运维售后进行综合打分。建议新手用户优先选择支持月付的专线机场体验。
      </p>
    </div>

    <!-- #1 Featured Airport Card -->
    {featuredAirport && (
      <div class="mb-8">
        <AirportCard airport={featuredAirport} rank={1} />
      </div>
    )}

    <!-- Other Airport Cards (4 per row) -->
    {otherAirports.length > 0 && (
      <div class="mb-16">
        <div class="flex items-center gap-2 mb-5">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
          <h2 class="text-lg font-bold text-slate-800">
            全部高性价比机场推荐精选（第 2 - {AIRPORTS.length} 名）
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {otherAirports.map((airport, idx) => (
            <AirportGridCard airport={airport} rank={idx + 2} />
          ))}
        </div>
      </div>
    )}

    <!-- Table View -->
    <div class="pt-10 border-t border-slate-200">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">
        📊 快速参数总览表
      </h2>
      <ComparisonTable />
    </div>
  </div>
</BaseLayout>
