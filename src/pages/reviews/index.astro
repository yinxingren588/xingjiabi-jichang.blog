---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG, AIRPORTS } from '../../data/airports';

const reviews = await getCollection('reviews');
const sortedReviews = reviews.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title={`2026年度跨国网络服务商专项性能实测报告与评测档案 - ${SITE_CONFIG.title}`}
  description="客观公正的跨国网络加速服务商专项测试报告与评测档案。基于家用千兆宽带晚高峰全时段实机压测、多节点下行吞吐、抖动控制、AI与流媒体解锁能力多维评估。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-3">
        <span>📝 专项性能深度测试档案 (14 家完整收录)</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
        服务商全链路实机测试与晚高峰基准档案
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        所有测试报告均建立在标准化真实网络环境下，于每晚 20:30 - 22:30 典型拥塞时段进行多轮并发压测，完整记录下行带宽、丢包率、Jitter 抖动及跨国高风控平台原生通过率。
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedReviews.map((rev) => {
        const airport = AIRPORTS.find((a) => a.id === rev.data.airportId);
        return (
          <article class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-lg hover:border-blue-400 transition-all flex flex-col justify-between p-6 group">
            <div>
              {/* Header with Logo & Rating */}
              <div class="flex items-center justify-between gap-2 mb-4">
                <div class="flex items-center gap-2.5 min-w-0">
                  {airport?.logo ? (
                    <img
                      src={airport.logo}
                      alt={rev.data.title}
                      class="w-9 h-9 rounded-xl object-cover border border-slate-100 shadow-xs shrink-0 bg-white"
                    />
                  ) : (
                    <div class="w-9 h-9 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-700 font-bold text-xs shrink-0">
                      {airport?.name.slice(0, 2) || '评测'}
                    </div>
                  )}
                  <div class="min-w-0">
                    <span class="font-bold text-xs text-slate-900 truncate block">
                      {airport?.name || '深度测评'}
                    </span>
                    <time datetime={rev.data.pubDate.toISOString()} class="text-[10px] text-slate-400">
                      {rev.data.pubDate.toLocaleDateString('zh-CN')}
                    </time>
                  </div>
                </div>

                <span class="font-bold text-xs text-amber-600 bg-amber-50 px-2 py-0.5 rounded border border-amber-200 shrink-0">
                  ★ {rev.data.rating.toFixed(1)}
                </span>
              </div>

              {/* Title */}
              <h2 class="text-base font-bold text-slate-900 mb-2.5 line-clamp-2 group-hover:text-blue-600 transition-colors leading-snug">
                <a href={`/reviews/${rev.id}`}>
                  {rev.data.title}
                </a>
              </h2>

              {/* Description */}
              <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed mb-4">
                {rev.data.description}
              </p>
            </div>

            {/* Footer */}
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400 text-[11px] font-medium">实验室实测</span>
              <a
                href={`/reviews/${rev.id}`}
                class="font-bold text-blue-600 hover:text-blue-800 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
              >
                阅读深度实测报告 &rarr;
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
