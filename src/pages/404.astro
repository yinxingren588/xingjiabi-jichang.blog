---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../data/airports';
---

<BaseLayout title={`404 页面未找到 - ${SITE_CONFIG.title}`}>
  <div class="max-w-xl mx-auto px-4 py-24 text-center">
    <div class="text-7xl font-black text-blue-600 mb-4">404</div>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">抱歉，您访问的页面不存在或已迁移</h1>
    <p class="text-sm text-slate-500 mb-8">
      可能该测评文章已被整合，或者链接地址有误。
    </p>
    <div class="flex items-center justify-center gap-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 transition-colors"
      >
        返回博客首页
      </a>
      <a
        href="/airports"
        class="px-5 py-2.5 rounded-xl bg-white border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-50 transition-colors"
      >
        查看 2026 机场榜单
      </a>
    </div>
  </div>
</BaseLayout>
