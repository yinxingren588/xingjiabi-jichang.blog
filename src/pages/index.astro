---
import BaseLayout from '../layouts/BaseLayout.astro';
import AirportCard from '../components/AirportCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { AIRPORTS, SITE_CONFIG } from '../data/airports';
import { getCollection } from 'astro:content';

const allReviews = await getCollection('reviews');
const allGuides = await getCollection('guides');

const sortedReviews = allReviews.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const sortedGuides = allGuides.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<BaseLayout
  title={`${SITE_CONFIG.title} - 2026最新优质稳定便宜机场推荐与评测`}
  description={SITE_CONFIG.description}
>
  {/* Hero Section */}
  <section class="relative overflow-hidden pt-12 pb-16 lg:pt-20 lg:pb-24 bg-gradient-to-b from-blue-50/60 via-white to-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      {/* Pill Badge */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100/80 text-blue-800 text-xs font-semibold mb-6 shadow-sm border border-blue-200">
        <span class="flex h-2 w-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>2026 年最新季度晚高峰实测数据已全面更新</span>
      </div>

      {/* Main Title */}
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto mb-6">
        做最懂你的 <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">性价比机场</span> 推荐评测站
      </h1>

      {/* Subtitle */}
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed">
        拒绝超卖虚标与低质跑路！我们坚持晚高峰实地测速、真机解锁 ChatGPT / 流媒体测试，为您精选全专线、IEPL、按量付费及平价实惠的科学上网梯子。
      </p>

      {/* Hero Buttons */}
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-12">
        <a
          href="#recommendations"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm sm:text-base shadow-lg shadow-blue-500/25 hover:shadow-blue-500/35 transition-all transform hover:-translate-y-0.5"
        >
          <span>🏆 查看 2026 性价比排行榜</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
        <a
          href="/guides"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm sm:text-base border border-slate-300 shadow-sm transition-all"
        >
          <span>📖 新手客户端配置教程</span>
        </a>
      </div>

      {/* Trust Stats Bar */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto pt-6 border-t border-slate-200/80 text-center">
        <div>
          <div class="text-2xl font-black text-slate-900">100%</div>
          <div class="text-xs text-slate-500 mt-0.5">晚高峰真实实测</div>
        </div>
        <div>
          <div class="text-2xl font-black text-blue-600">IEPL 专线</div>
          <div class="text-xs text-slate-500 mt-0.5">不过 GFW 敏感网关</div>
        </div>
        <div>
          <div class="text-2xl font-black text-slate-900">¥9.90 起</div>
          <div class="text-xs text-slate-500 mt-0.5">月付门槛超低负担</div>
        </div>
        <div>
          <div class="text-2xl font-black text-emerald-600">全绿解锁</div>
          <div class="text-xs text-slate-500 mt-0.5">原生 ChatGPT / 流媒体</div>
        </div>
      </div>
    </div>
  </section>

  {/* Main Section: Top Airport Cards */}
  <section id="recommendations" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <div class="flex items-center gap-2 text-blue-600 font-bold text-xs uppercase tracking-wider mb-1">
          <span>Top Picks 2026</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          🏆 精选高性价比机场排行榜
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          综合节点稳定性、晚高峰带宽、解锁能力、客户口碑与实付价格评定
        </p>
      </div>
      <a href="/airports" class="text-sm font-semibold text-blue-600 hover:text-blue-800 flex items-center gap-1">
        查看完整榜单
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    {/* Airport Cards */}
    <div class="space-y-6">
      {AIRPORTS.map((airport, index) => (
        <AirportCard airport={airport} rank={index + 1} />
      ))}
    </div>
  </section>

  {/* Section: Comparison Table */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        📊 推荐机场核心参数横向对比
      </h2>
      <p class="text-sm text-slate-500 mt-1">
        一览各家线路类型、起步价、晚高峰速度及优惠码，方便快速对比选购
      </p>
    </div>

    <ComparisonTable />
  </section>

  {/* Section: Latest Reviews & Guides Grid */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-slate-200">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {/* Left: Latest Reviews */}
      <div>
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
              <span>📝 深度跑分测评专栏</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">实机压测报告与套餐避坑分析</p>
          </div>
          <a href="/reviews" class="text-xs font-semibold text-blue-600 hover:underline">更多测评 &rarr;</a>
        </div>

        <div class="space-y-4">
          {sortedReviews.map((rev) => (
            <a
              href={`/reviews/${rev.id}`}
              class="block p-5 rounded-xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all group"
            >
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                  ★ {rev.data.rating.toFixed(1)} 分
                </span>
                <span class="text-xs text-slate-400">
                  {rev.data.pubDate.toLocaleDateString('zh-CN')}
                </span>
              </div>
              <h3 class="font-bold text-slate-800 text-base group-hover:text-blue-600 transition-colors line-clamp-2">
                {rev.data.title}
              </h3>
              <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                {rev.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>

      {/* Right: Beginner Guides */}
      <div>
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
              <span>📖 客户端新手教程</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Windows / Mac / iOS / Android 零基础指引</p>
          </div>
          <a href="/guides" class="text-xs font-semibold text-blue-600 hover:underline">全部教程 &rarr;</a>
        </div>

        <div class="space-y-4">
          {sortedGuides.map((guide) => (
            <a
              href={`/guides/${guide.id}`}
              class="block p-5 rounded-xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all group"
            >
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-xs font-semibold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">
                  {guide.data.client}
                </span>
                <span class="text-xs text-slate-400">
                  适合: {guide.data.platform}
                </span>
                <span class="text-xs text-slate-400">· {guide.data.difficulty}</span>
              </div>
              <h3 class="font-bold text-slate-800 text-base group-hover:text-blue-600 transition-colors line-clamp-2">
                {guide.data.title}
              </h3>
              <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                {guide.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Section: FAQ */}
  <section id="faq" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200">
    <div class="text-center mb-10">
      <span class="text-xs font-bold text-blue-600 tracking-wider uppercase">F.A.Q</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">
        ❓ 科学上网与性价比机场选购指南
      </h2>
      <p class="text-sm text-slate-500 mt-1">
        解答你在购买和使用机场过程中最常遇到的疑问与避坑要点
      </p>
    </div>

    <FaqAccordion />
  </section>
</BaseLayout>
