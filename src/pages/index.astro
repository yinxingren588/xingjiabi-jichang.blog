---
import BaseLayout from '../layouts/BaseLayout.astro';
import AirportCard from '../components/AirportCard.astro';
import AirportGridCard from '../components/AirportGridCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { AIRPORTS, SITE_CONFIG } from '../data/airports';
import { getCollection } from 'astro:content';

const [featuredAirport, ...otherAirports] = AIRPORTS;

const allReviews = await getCollection('reviews');
const allGuides = await getCollection('guides');

const sortedReviews = allReviews.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
const sortedGuides = allGuides.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 3);
---

<BaseLayout
  title={`${SITE_CONFIG.title} - ${SITE_CONFIG.subtitle}`}
  description={SITE_CONFIG.description}
>
  {/* Hero Section */}
  <section class="relative overflow-hidden pt-12 pb-16 lg:pt-20 lg:pb-24 bg-gradient-to-b from-blue-50/50 via-white to-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      {/* Pill Badge */}
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold mb-6 shadow-xs border border-blue-200/80">
        <span class="flex h-2 w-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>2026 年度跨国网络链路基准与可用性评估报告已更新</span>
      </div>

      {/* Main Title - Strictly prevent word breaking */}
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.2] max-w-4xl mx-auto mb-6">
        <span class="block text-base sm:text-2xl font-bold text-slate-500 mb-2 sm:mb-3 tracking-normal">
          2026 跨国物理专线与服务可用性综合评估
        </span>
        <span class="inline-block whitespace-nowrap">权威实测 ·</span>
        <span class="inline-block whitespace-nowrap text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 mx-1 sm:mx-2">
          性价比机场
        </span>
        <span class="inline-block whitespace-nowrap">选型决策指南</span>
      </h1>

      {/* Subtitle */}
      <p class="text-sm sm:text-base lg:text-lg text-slate-600 max-w-3xl mx-auto mb-10 leading-relaxed">
        建立在真实网络环境下的中立评测基准。我们通过千兆家用宽带在晚高峰时段对主流服务商进行全节点并发压测，涵盖 <strong class="text-slate-800 font-semibold">IEPL 物理专线延迟、4K/8K 视频流媒体吞吐、原生住宅 IP 纯净度及抗拥塞能力</strong>，为您提供量化、透明的节点选型决策数据。
      </p>

      {/* Hero Buttons */}
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mb-14">
        <a
          href="#recommendations"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm sm:text-base shadow-lg shadow-blue-500/25 hover:shadow-blue-500/35 transition-all transform hover:-translate-y-0.5"
        >
          <span>🏆 查阅 2026 综合评级榜单</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
        <a
          href="/guides"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm sm:text-base border border-slate-300 shadow-xs transition-all hover:border-slate-400"
        >
          <span>📖 客户端标准化部署指引</span>
        </a>
      </div>

      {/* Trust Stats Bar - Elevated cards */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto pt-6 border-t border-slate-200/80">
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:border-blue-200 transition-colors">
          <div class="text-base sm:text-lg font-black text-slate-900">晚高峰全压测</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-1">20:00-23:00 真实带宽基准</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:border-blue-200 transition-colors">
          <div class="text-base sm:text-lg font-black text-blue-600">IEPL 企业专线</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-1">低抖动不过公网敏感网关</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:border-blue-200 transition-colors">
          <div class="text-base sm:text-lg font-black text-slate-900">¥9.90 /月起</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-1">高性价比弹性订阅支持</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs hover:border-blue-200 transition-colors">
          <div class="text-base sm:text-lg font-black text-emerald-600">高纯净住宅 IP</div>
          <div class="text-[11px] sm:text-xs text-slate-500 mt-1">原生解锁 ChatGPT / 流媒体</div>
        </div>
      </div>
    </div>
  </section>

  {/* Main Section: Top Airport Cards */}
  <section id="recommendations" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <div class="flex items-center gap-2 text-blue-600 font-bold text-xs uppercase tracking-wider mb-1">
          <span>Benchmark & Evaluation 2026</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          🏆 2026 年度高性价比网络加速服务综合性能评级
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          基于节点晚高峰吞吐、丢包控制、企业级物理专线覆盖率、AI 原生 IP 解锁及综合资费模型加权评定
        </p>
      </div>
      <a href="/airports" class="text-sm font-semibold text-blue-600 hover:text-blue-800 flex items-center gap-1">
        查看完整榜单
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    {/* Airport Cards: #1 Featured Large Card */}
    {featuredAirport && (
      <div class="mb-8">
        <AirportCard airport={featuredAirport} rank={1} />
      </div>
    )}

    {/* Airport Cards: Other Brands (4 per row on desktop) */}
    {otherAirports.length > 0 && (
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
          <h3 class="text-base font-bold text-slate-800">
            优质梯队推荐服务商（第 2 - {AIRPORTS.length} 名）
          </h3>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
          {otherAirports.map((airport, idx) => (
            <AirportGridCard airport={airport} rank={idx + 2} />
          ))}
        </div>
      </div>
    )}
  </section>

  {/* Section: Comparison Table */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        📊 核心服务商网络参数与资费横向基准对比表
      </h2>
      <p class="text-sm text-slate-500 mt-1">
        全维度横向对比线路类型、起步费率、晚高峰吞吐表现及专属优惠码
      </p>
    </div>

    <ComparisonTable />
  </section>

  {/* Section: Latest Reviews & Guides Grid */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-slate-200">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {/* Left: Latest Reviews */}
      <div>
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
              <span>📝 专项性能深度测试报告与测评档案</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">多节点晚高峰带宽吞吐、抖动分析及套餐成本效益分析</p>
          </div>
          <a href="/reviews" class="text-xs font-semibold text-blue-600 hover:underline">更多测评报告 &rarr;</a>
        </div>

        <div class="space-y-4">
          {sortedReviews.map((rev) => (
            <a
              href={`/reviews/${rev.id}`}
              class="block p-5 rounded-xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all group"
            >
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                  ★ {rev.data.rating.toFixed(1)} 综合评级
                </span>
                <span class="text-xs text-slate-400">
                  {rev.data.pubDate.toLocaleDateString('zh-CN')}
                </span>
              </div>
              <h3 class="font-bold text-slate-800 text-base group-hover:text-blue-600 transition-colors line-clamp-2">
                {rev.data.title}
              </h3>
              <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                {rev.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>

      {/* Right: Beginner Guides */}
      <div>
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
              <span>📖 跨平台客户端标准化部署与规则分流配置</span>
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">全平台主流协议核心（Clash / Sing-box / Shadowrocket）标准化接入指引</p>
          </div>
          <a href="/guides" class="text-xs font-semibold text-blue-600 hover:underline">全部指南 &rarr;</a>
        </div>

        <div class="space-y-4">
          {sortedGuides.map((guide) => (
            <a
              href={`/guides/${guide.id}`}
              class="block p-5 rounded-xl bg-white border border-slate-200 hover:border-blue-400 hover:shadow-md transition-all group"
            >
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-xs font-semibold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">
                  {guide.data.client}
                </span>
                <span class="text-xs text-slate-400">
                  适用系统: {guide.data.platform}
                </span>
                <span class="text-xs text-slate-400">· {guide.data.difficulty}</span>
              </div>
              <h3 class="font-bold text-slate-800 text-base group-hover:text-blue-600 transition-colors line-clamp-2">
                {guide.data.title}
              </h3>
              <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                {guide.data.description}
              </p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Section: FAQ */}
  <section id="faq" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 border-t border-slate-200">
    <div class="text-center mb-10">
      <span class="text-xs font-bold text-blue-600 tracking-wider uppercase">Technical FAQ</span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">
        ❓ 跨国网络加速与节点选型核心考量（FAQ）
      </h2>
      <p class="text-sm text-slate-500 mt-1">
        梳理跨国链路选型、协议兼容性、IP纯净度与服务商可靠性常见疑问
      </p>
    </div>

    <FaqAccordion />
  </section>
</BaseLayout>
