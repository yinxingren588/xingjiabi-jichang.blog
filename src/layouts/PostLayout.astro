---
import BaseLayout from './BaseLayout.astro';
import { AIRPORTS, type Airport } from '../data/airports';
import CopyButton from '../components/CopyButton.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: 'reviews' | 'guides';
  categoryName: string;
  airportId?: string;
  rating?: number;
  pros?: string[];
  cons?: string[];
  readingTime?: string;
}

const {
  title,
  description,
  pubDate,
  category,
  categoryName,
  airportId,
  rating,
  pros = [],
  cons = [],
  readingTime,
} = Astro.props;

const airport: Airport | undefined = airportId ? AIRPORTS.find((a) => a.id === airportId) : undefined;
---

<BaseLayout title={`${title} - 性价比机场`} description={description} type="article">
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-blue-600">首页</a>
      <span>/</span>
      <a href={`/${category}`} class="hover:text-blue-600">{categoryName}</a>
      <span>/</span>
      <span class="text-slate-800 font-medium truncate max-w-[240px] sm:max-w-md">{title}</span>
    </nav>

    {/* Header */}
    <header class="mb-8 pb-8 border-b border-slate-200">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
          {categoryName}
        </span>
        {rating && (
          <span class="flex items-center gap-1 text-xs font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded border border-amber-200">
            ★ 评测得分: {rating.toFixed(1)} / 5.0
          </span>
        )}
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
        {readingTime && (
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>预估阅读时间: {readingTime}</span>
          </div>
        )}
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>实测验证有效</span>
        </div>
      </div>
    </header>

    {/* Airport Quick Action Callout (If linked to airport) */}
    {airport && (
      <div class="mb-10 p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-4">
          {airport.logo && (
            <img
              src={airport.logo}
              alt={airport.name}
              class="w-14 h-14 rounded-2xl object-cover border border-slate-200 shadow-sm shrink-0 bg-white"
            />
          )}
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-slate-900 text-lg">{airport.name}</span>
              {airport.badge && (
                <span class="text-xs px-2 py-0.5 rounded bg-blue-600 text-white font-medium">
                  {airport.badge}
                </span>
              )}
            </div>
            <p class="text-xs text-slate-600 mb-2">{airport.tagline} · {airport.lineType}</p>
            <div class="flex items-center gap-2">
              <span class="text-sm font-bold text-blue-700">{airport.price}{airport.priceNote}</span>
              {airport.discountCode && (
                <CopyButton text={airport.discountCode} label={airport.discountNote || '领券'} />
              )}
            </div>
          </div>
        </div>
        <a
          href={`/go/${airport.id}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold shadow-md hover:shadow-lg transition-all"
        >
          <span>直达官网注册</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    )}

    {/* Pros and Cons Block */}
    {(pros.length > 0 || cons.length > 0) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        {pros.length > 0 && (
          <div class="p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200">
            <h3 class="text-sm font-bold text-emerald-900 flex items-center gap-1.5 mb-3">
              <span class="text-base">👍</span> 核心优势 (Pros)
            </h3>
            <ul class="space-y-2 text-xs sm:text-sm text-emerald-950">
              {pros.map((p) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {cons.length > 0 && (
          <div class="p-5 rounded-2xl bg-rose-50/70 border border-rose-200">
            <h3 class="text-sm font-bold text-rose-900 flex items-center gap-1.5 mb-3">
              <span class="text-base">⚠️</span> 选购注意事项 (Cons)
            </h3>
            <ul class="space-y-2 text-xs sm:text-sm text-rose-950">
              {cons.map((c) => (
                <li class="flex items-start gap-2">
                  <span class="text-rose-600 font-bold">✕</span>
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    {/* Markdown Body */}
    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-5
      [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-slate-900 [&>h2]:mt-10 [&>h2]:mb-4 [&>h2]:pt-4 [&>h2]:border-t [&>h2]:border-slate-200
      [&>h3]:text-xl [&>h3]:font-bold [&>h3]:text-slate-800 [&>h3]:mt-6 [&>h3]:mb-3
      [&>p]:my-4 [&>p]:leading-7
      [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:space-y-2
      [&>ol]:list-decimal [&>ol]:pl-5 [&>ol]:space-y-2
      [&>table]:w-full [&>table]:border-collapse [&>table]:my-6
      [&>table_th]:bg-slate-100 [&>table_th]:p-3 [&>table_th]:border [&>table_th]:border-slate-200 [&>table_th]:text-slate-800 [&>table_th]:font-semibold
      [&>table_td]:p-3 [&>table_td]:border [&>table_td]:border-slate-200
      [&>blockquote]:border-l-4 [&>blockquote]:border-blue-500 [&>blockquote]:bg-blue-50/50 [&>blockquote]:p-4 [&>blockquote]:rounded-r-lg [&>blockquote]:my-5
    ">
      <slot />
    </div>

    {/* Article Footer */}
    <div class="mt-14 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <a
        href={`/${category}`}
        class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-800"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        返回{categoryName}列表
      </a>
      <a
        href="/airports"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-slate-800"
      >
        🚀 查看 2026 最新性价比排行榜
      </a>
    </div>
  </article>
</BaseLayout>
