---
import { HOME_FEATURED_FAQS } from '../data/faqs';
import { marked } from 'marked';

// Render the 8 featured home FAQs with markdown
const faqs = HOME_FEATURED_FAQS.map(faq => ({
  ...faq,
  htmlAnswer: marked.parse(faq.fullAnswer)
}));
---

<div class="space-y-4">
  {faqs.map((faq, index) => (
    <details class="group bg-white rounded-2xl border border-slate-200/90 overflow-hidden transition-all duration-200 hover:border-blue-300 hover:shadow-2xs">
      <summary class="flex items-center justify-between p-5 text-left font-bold text-slate-800 cursor-pointer list-none select-none">
        <span class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 text-xs font-black flex items-center justify-center shrink-0 border border-blue-100">
            Q{index + 1}
          </span>
          <span class="text-base text-slate-900 group-hover:text-blue-600 transition-colors">
            {faq.question}
          </span>
        </span>
        <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="px-6 pb-6 pt-2 border-t border-slate-100 bg-slate-50/40">
        {/* Core Summary Box */}
        <div class="bg-blue-50/80 rounded-xl p-3 border border-blue-100 text-xs text-blue-900 mb-4 flex items-start gap-2">
          <span class="text-blue-600 font-bold shrink-0">📌 核心结论：</span>
          <span class="font-medium leading-relaxed">{faq.shortSummary}</span>
        </div>

        {/* Full Rich Answer */}
        <div class="faq-content text-sm" set:html={faq.htmlAnswer} />

        <div class="mt-4 pt-3 border-t border-slate-200/60 flex items-center justify-between text-xs">
          <span class="text-slate-400 font-medium">分类：{faq.categoryLabel}</span>
          <a
            href={`/faq#${faq.id}`}
            class="text-blue-600 hover:text-blue-800 font-bold inline-flex items-center gap-1"
          >
            查看知识库完整专栏直链 &rarr;
          </a>
        </div>
      </div>
    </details>
  ))}
</div>

{/* View All FAQs CTA Button */}
<div class="mt-8 text-center">
  <a
    href="/faq"
    class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold text-sm shadow-md hover:shadow-lg hover:from-blue-700 hover:to-indigo-700 transition-all"
  >
    <span>💡 浏览全部 32 篇深度技术 FAQ 问答与避坑专栏</span>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </a>
  <p class="text-xs text-slate-400 mt-2">
    涵盖 8 大技术分类 · 物理专线 / AI住宅IP / 客户端TUN / 资费避坑
  </p>
</div>
