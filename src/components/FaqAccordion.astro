---
const faqs = [
  {
    q: "如何挑选真正适合自己的【高性价比机场】？",
    a: "不要盲目追求极端低价（几块钱一年的往往超卖严重甚至随时跑路）。建议优先考虑：① 线路质量（纯 IEPL/IPLC 专线 > BGP 中继 > 直连公网）；② 晚高峰（20:00-23:00）的稳定性和丢包率；③ 是否支持月付或季付测试；④ 节点是否原生解锁你所需的 AI 工具（如 ChatGPT/Claude）或流媒体平台。"
  },
  {
    q: "IEPL 内网专线与普通中继/直连节点有什么区别？",
    a: "IEPL (International Ethernet Private Line) 是不过防火长城（GFW）公网国际出口的内网专用光纤通道，即便在重大会议或敏感时期也几乎不受封锁影响，延迟超低、无丢包；而普通公网中继或直连节点在敏感时期容易受到大面积丢包和阻断干扰。"
  },
  {
    q: "新手应该按月付还是按年付购买机场？",
    a: "强烈建议所有新手【首选月付或季付】！先用一个月亲测自己所在运营商网络（电信、联通、移动、校园网各不相同）在晚高峰的实际使用感受。确认稳定且契合自身需求后，再考虑通过年付优惠码锁定更低月均单价。"
  },
  {
    q: "为什么我的节点显示连接成功，却打不开 ChatGPT 或 Claude？",
    a: "OpenAI 和 Anthropic 对机房数据中心 IP 的风控极为严苛。如果大量用户共用同一个数据中心 IP，就会被官方风控屏蔽并提示「Access Denied」或「Not Available」。推荐选择本站列表中标注了「原生解锁 AI / 纯净住宅 IP」的机场节点。"
  },
  {
    q: "Clash、Sing-box、小火箭该选哪个客户端？",
    a: "① Windows & Mac 电脑端：推荐使用【Clash Verge Rev】，界面现代且性能卓越；② iOS 苹果手机/平板：推荐【Shadowrocket (小火箭)】或免费的【Sing-box】；③ Android 安卓手机：推荐【Clash Verge】或【Sing-box】。"
  }
];
---

<div class="space-y-4">
  {faqs.map((faq, index) => (
    <details class="group bg-white rounded-xl border border-slate-200 overflow-hidden transition-all duration-200 hover:border-slate-300">
      <summary class="flex items-center justify-between p-5 text-left font-bold text-slate-800 cursor-pointer list-none select-none">
        <span class="flex items-center gap-3">
          <span class="w-6 h-6 rounded-md bg-blue-50 text-blue-600 text-xs font-black flex items-center justify-center shrink-0">
            Q{index + 1}
          </span>
          <span class="text-base text-slate-900 group-hover:text-blue-600 transition-colors">
            {faq.q}
          </span>
        </span>
        <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-5 pb-5 pt-1 text-sm text-slate-600 leading-relaxed border-t border-slate-100 bg-slate-50/50">
        <p>{faq.a}</p>
      </div>
    </details>
  ))}
</div>
