      <!-- Col 2: Fast Links -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">快速导航</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">首页精选</a></li>
          <li><a href="/airports" class="hover:text-white transition-colors">2026性价比排行榜</a></li>
          <li><a href="/reviews" class="hover:text-white transition-colors">深度跑分测评专栏</a></li>
          <li><a href="/guides" class="hover:text-white transition-colors">常用客户端配置教程</a></li>
          <li><a href="/#faq" class="hover:text-white transition-colors">新手常见问题答疑</a></li>
        </ul>
      </div>

      <!-- Col 3: Client Guides -->
      <div>
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">客户端专题教程</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/guides/clash-verge-rev" class="hover:text-white transition-colors">Clash Verge Rev 教程</a></li>
          <li><a href="/guides/sing-box-guide" class="hover:text-white transition-colors">Sing-box 通用配置</a></li>
          <li><a href="/guides/shadowrocket-ios" class="hover:text-white transition-colors">小火箭 (Shadowrocket) 教程</a></li>
          <li><a href="/disclaimer" class="hover:text-white transition-colors">免责声明与服务协议</a></li>
        </ul>
