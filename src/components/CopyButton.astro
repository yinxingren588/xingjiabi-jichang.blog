---
interface Props {
  text: string;
  label?: string;
}

const { text, label = '复制优惠码' } = Astro.props;
---

<button
  type="button"
  data-copy={text}
  class="copy-btn inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-medium rounded border border-amber-300 bg-amber-50 text-amber-900 hover:bg-amber-100 transition-colors cursor-pointer group"
  title="点击复制优惠码"
>
  <svg class="w-3.5 h-3.5 text-amber-700 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
  </svg>
  <span class="font-bold">{text}</span>
  <span class="text-[10px] text-amber-700/80 copy-label">({label})</span>
</button>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLElement;
      const textToCopy = target.getAttribute('data-copy');
      const labelEl = target.querySelector('.copy-label');
      if (textToCopy) {
        try {
          await navigator.clipboard.writeText(textToCopy);
          if (labelEl) {
            const originalText = labelEl.textContent;
            labelEl.textContent = '✓ 已复制!';
            target.classList.add('bg-emerald-100', 'border-emerald-300', 'text-emerald-900');
            setTimeout(() => {
              labelEl.textContent = originalText;
              target.classList.remove('bg-emerald-100', 'border-emerald-300', 'text-emerald-900');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy', err);
        }
      }
    });
  });
</script>
