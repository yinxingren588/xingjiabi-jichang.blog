---
import type { Airport } from '../data/airports';
import CopyButton from './CopyButton.astro';

interface Props {
  airport: Airport;
  rank: number;
}

const { airport, rank } = Astro.props;

const badgeColors = {
  blue: 'bg-blue-50 text-blue-700 border-blue-200',
  emerald: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  amber: 'bg-amber-50 text-amber-700 border-amber-200',
  rose: 'bg-rose-50 text-rose-700 border-rose-200',
  purple: 'bg-purple-50 text-purple-700 border-purple-200',
};

const badgeClass = airport.badgeColor ? badgeColors[airport.badgeColor] : badgeColors.blue;
---

<div class="relative bg-white rounded-2xl border border-slate-200 hover:border-blue-400 hover:shadow-xl transition-all duration-300 flex flex-col justify-between p-5 group">
  {/* Rank Indicator */}
  <div class="absolute -top-2.5 -left-2.5 w-7 h-7 rounded-full bg-slate-900 text-white font-black text-xs flex items-center justify-center shadow-md">
    #{rank}
  </div>

  <div>
    {/* Header: Logo + Title + Rating */}
    <div class="flex items-start justify-between gap-2 mb-3 pt-1">
      <div class="flex items-center gap-2.5 min-w-0">
        {airport.logo ? (
          <img
            src={airport.logo}
            alt={airport.name}
            class="w-10 h-10 rounded-xl object-cover border border-slate-100 shadow-xs shrink-0 bg-white"
          />
        ) : (
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-slate-100 to-slate-200 border border-slate-200 flex items-center justify-center text-slate-700 font-bold text-xs shrink-0">
            {airport.name.slice(0, 2)}
          </div>
        )}
        <div class="min-w-0">
          <h3 class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors text-base truncate">
            {airport.name}
          </h3>
          <div class="flex items-center gap-1 text-[11px] text-amber-600 font-bold">
            <span>★ {airport.rating.toFixed(1)}</span>
            <span class="text-slate-400 font-normal">({airport.reviewCount})</span>
          </div>
        </div>
      </div>
    </div>

    {/* Badge */}
    {airport.badge && (
      <div class="mb-2">
        <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-semibold border ${badgeClass} truncate max-w-full`}>
          {airport.badge}
        </span>
      </div>
    )}

    {/* Tagline */}
    <p class="text-xs text-slate-500 line-clamp-2 mb-3 leading-relaxed min-h-[32px]">
      {airport.tagline}
    </p>

    {/* Specs Compact Box */}
    <div class="space-y-1.5 py-2.5 px-3 rounded-xl bg-slate-50 border border-slate-100 text-[11px] mb-3">
      <div class="flex items-center justify-between">
        <span class="text-slate-400">线路类型</span>
        <span class="font-medium text-slate-700 truncate max-w-[110px]">{airport.lineType}</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-slate-400">晚高峰测速</span>
        <span class="font-mono font-semibold text-blue-600">{airport.speedPeak.split(' ')[0]}</span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-slate-400">基础流量</span>
        <span class="font-medium text-slate-700">{airport.traffic.split('-')[0].trim()}</span>
      </div>
    </div>

    {/* Discount Code */}
    <div class="min-h-[28px] mb-3 flex items-center">
      {airport.discountCode ? (
        <CopyButton text={airport.discountCode} label="券" />
      ) : (
        <span class="text-[11px] text-slate-400 bg-slate-100 px-2 py-0.5 rounded">支持新客特惠</span>
      )}
    </div>
  </div>

  {/* Footer: Price & CTA Actions */}
  <div class="pt-3 border-t border-slate-100">
    <div class="flex items-baseline justify-between mb-3">
      <div class="flex items-center gap-1.5">
        <span class="text-[11px] text-slate-400">起步价格</span>
        {airport.plans && airport.plans.length > 0 && (
          <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded font-medium">
            {airport.plans.length}档配套
          </span>
        )}
      </div>
      <div class="text-right">
        <span class="text-xl font-black text-slate-900">{airport.price}</span>
        <span class="text-[10px] text-slate-400">{airport.priceNote}</span>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-2">
      {airport.reviewSlug && (
        <a
          href={`/reviews/${airport.reviewSlug}`}
          class="py-2 text-center rounded-xl border border-slate-200 hover:border-slate-300 text-slate-700 hover:bg-slate-50 text-xs font-semibold transition-colors"
        >
          查看评测
        </a>
      )}
      <a
        href={`/go/${airport.id}`}
        target="_blank"
        rel="noopener noreferrer"
        class={`py-2 text-center inline-flex items-center justify-center gap-1 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow-sm shadow-blue-500/10 transition-colors ${
          !airport.reviewSlug ? 'col-span-2' : ''
        }`}
      >
        <span>直达官网</span>
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</div>
