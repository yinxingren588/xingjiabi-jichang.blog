---
import type { Airport } from '../data/airports';
import CopyButton from './CopyButton.astro';

interface Props {
  airport: Airport;
  rank?: number;
}

const { airport, rank } = Astro.props;

const badgeColors = {
  blue: 'bg-blue-100 text-blue-800 border-blue-200',
  emerald: 'bg-emerald-100 text-emerald-800 border-emerald-200',
  amber: 'bg-amber-100 text-amber-800 border-amber-200',
  rose: 'bg-rose-100 text-rose-800 border-rose-200',
  purple: 'bg-purple-100 text-purple-800 border-purple-200',
};

const badgeClass = airport.badgeColor ? badgeColors[airport.badgeColor] : badgeColors.blue;
---

<div class={`relative bg-white rounded-2xl border transition-all duration-300 hover:shadow-xl ${
  airport.isRecommended ? 'border-blue-400 ring-2 ring-blue-500/10 shadow-lg' : 'border-slate-200 hover:border-slate-300'
}`}>
  {/* Rank Indicator */}
  {rank && (
    <div class="absolute -top-3 -left-3 w-8 h-8 rounded-full bg-slate-900 text-white font-black text-sm flex items-center justify-center shadow-md">
      #{rank}
    </div>
  )}

  <div class="p-6 sm:p-7">
    {/* Header: Logo, Badge & Title */}
    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
      <div class="flex items-start gap-3.5">
        {airport.logo ? (
          <img
            src={airport.logo}
            alt={airport.name}
            class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl object-cover border border-slate-200/80 shadow-sm shrink-0 bg-white"
          />
        ) : (
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-slate-100 to-slate-200 border border-slate-200/80 flex items-center justify-center text-slate-700 font-bold text-lg shrink-0">
            {airport.name.slice(0, 2)}
          </div>
        )}
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 hover:text-blue-600 transition-colors">
              {airport.name}
            </h3>
            {airport.badge && (
              <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeClass}`}>
                {airport.badge}
              </span>
            )}
          </div>
          <p class="text-xs sm:text-sm text-slate-500">{airport.tagline}</p>
        </div>
      </div>

      {/* Rating */}
      <div class="flex items-center gap-1.5 bg-slate-50 px-3 py-1.5 rounded-xl border border-slate-100">
        <span class="text-amber-500 text-sm">★</span>
        <span class="font-bold text-slate-800 text-sm">{airport.rating.toFixed(1)}</span>
        <span class="text-xs text-slate-400">({airport.reviewCount}人评)</span>
      </div>
    </div>

    {/* Key Specs Grid */}
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-5 p-3.5 rounded-xl bg-slate-50/80 border border-slate-100 text-xs">
      <div>
        <span class="text-slate-400 block mb-0.5">线路类型</span>
        <span class="font-semibold text-slate-700 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          {airport.lineType}
        </span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">晚高峰测速</span>
        <span class="font-semibold text-blue-700 font-mono">{airport.speedPeak}</span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">基础流量</span>
        <span class="font-semibold text-slate-700">{airport.traffic}</span>
      </div>
      <div>
        <span class="text-slate-400 block mb-0.5">解锁能力</span>
        <span class="font-semibold text-emerald-700 truncate block">Netflix / ChatGPT</span>
      </div>
    </div>

    {/* Features List */}
    <div class="mb-5">
      <ul class="space-y-2 text-sm text-slate-600">
        {airport.features.map((feat) => (
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>{feat}</span>
          </li>
        ))}
      </ul>
    </div>

    {/* Supported Tags */}
    <div class="flex flex-wrap items-center gap-1.5 mb-5">
      <span class="text-xs text-slate-400 mr-1">支持协议:</span>
      {airport.protocols.map((p) => (
        <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 text-slate-600 border border-slate-200">
          {p}
        </span>
      ))}
      <span class="text-xs text-slate-400 ml-2 mr-1">原生解锁:</span>
      {airport.unlocks.slice(0, 4).map((u) => (
        <span class="px-2 py-0.5 rounded text-[11px] bg-emerald-50 text-emerald-700 border border-emerald-200">
          {u}
        </span>
      ))}
    </div>

    {/* Featured Official Plans Overview */}
    {airport.plans && airport.plans.length > 0 && (
      <div class="mb-5 p-4 rounded-xl bg-slate-50 border border-slate-200/80">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-600"></span>
            <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">官方全系配套价格参考</span>
          </div>
          {airport.reviewSlug && (
            <a href={`/reviews/${airport.reviewSlug}`} class="text-xs font-semibold text-blue-600 hover:text-blue-800 flex items-center gap-1">
              <span>查看全部 {airport.plans.length} 档配套明细</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
          {airport.plans.slice(0, 4).map((plan) => (
            <div class="p-2.5 rounded-lg bg-white border border-slate-200/90 shadow-2xs hover:border-blue-300 transition-colors">
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="font-bold text-xs text-slate-800 truncate">{plan.name}</span>
                {plan.badge && (
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200 shrink-0 font-medium">
                    {plan.badge.split('·')[0].trim().slice(0, 6)}
                  </span>
                )}
              </div>
              <div class="text-[11px] text-slate-500 mb-1">{plan.traffic}</div>
              <div class="flex items-baseline gap-1">
                <span class="text-sm font-extrabold text-blue-700">{plan.price}</span>
                <span class="text-[10px] text-slate-400">{plan.period}</span>
              </div>
              {plan.effective && (
                <div class="text-[10px] text-emerald-600 font-medium truncate mt-0.5">
                  {plan.effective}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Footer: Price & CTA Actions */}
    <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      {/* Price & Discount Code */}
      <div class="flex flex-col">
        <div class="flex items-baseline gap-1">
          <span class="text-2xl sm:text-3xl font-extrabold text-slate-900">{airport.price}</span>
          <span class="text-xs text-slate-500">{airport.priceNote}</span>
        </div>
        {airport.discountCode && (
          <div class="mt-1 flex items-center gap-2">
            <CopyButton text={airport.discountCode} label={airport.discountNote || '复制券码'} />
          </div>
        )}
      </div>

      {/* Buttons */}
      <div class="flex items-center gap-2.5 w-full sm:w-auto">
        {airport.reviewSlug && (
          <a
            href={`/reviews/${airport.reviewSlug}`}
            class="flex-1 sm:flex-initial text-center px-4 py-2.5 rounded-xl border border-slate-300 hover:border-slate-400 text-slate-700 text-sm font-medium hover:bg-slate-50 transition-colors"
          >
            📖 查看实测
          </a>
        )}
        <a
          href={`/go/${airport.id}`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 sm:flex-initial text-center inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-md shadow-blue-500/20 hover:shadow-lg hover:shadow-blue-500/30 transition-all"
        >
          <span>直达官网注册</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
